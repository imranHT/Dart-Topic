//payment class

abstract class Payment {
  void pay(double amount);
}

//class bkash

import"payment.dart";

class Bkash extends Payment{
  @override
  void pay(double amount){
    print("Paid $amount using Bkash Account");
  }
}

//class mastercard

import"payment.dart";

class Mastercard extends Payment{

  @override

  void pay(double amount){
    print("Paid $amount using Master Card");
  }
}


