void main(){


  var marks = 90;


  switch(marks){

    case 90:
      print("A+");
      break;

    case 70:
      print("A");
      break;

    case 60:
      print("A-");
      break;

    case 50:
      print("B");
      break;

    case 40:
      print("C");
      break;

    case 33:
      print("D");
      break;


      default:
        print("Fail in the exam");
        break;

  }
}

