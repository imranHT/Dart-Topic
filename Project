  ];

  for (var bike in product) {
    double finalPrice = calculateDiscount(bike["price"] as int);

    print("======================================================");
    print("Talukdar Motor's");
    print("======================================================");
    print("Product : ${bike["name"]}");
    print("Model : ${bike["model"] ?? "N/A"}");
    print("Price ${bike["price"]}");
    print("After Discount: ${finalPrice.toStringAsFixed(2)}");
 
  }
}
  double calculateDiscount(int price){
  double discount = price * 0.10;
   return price - discount;
   
}

